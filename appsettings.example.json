{
  "ApiKey": "your-strong-api-key-here",
  "App": {
    "FrontendUrl": "http://localhost:3000"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=DataForgeDB;Username=postgres;Password=your-db-password;"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-at-least-32-characters!!",
    "Issuer": "DataForge",
    "Audience": "DataForge",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "CorsSettings": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5173"
  },
  "MailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "your-email@example.com",
    "Password": "your-smtp-app-password",
    "From": "No Reply <noreply@app.com>"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowMinutes": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
